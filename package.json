{
  "name": "async-modal-render-native",
  "version": "0.1.3",
  "description": "A lightweight React Native library that promisifies modal operations with async/await syntax",
  "keywords": [
    "react",
    "modal",
    "promise",
    "async",
    "await",
    "dialog",
    "popup",
    "promisify",
    "awaitable",
    "typescript"
  ],
  "homepage": "https://github.com/Byte-n/async-modal-render-native#readme",
  "bugs": {
    "url": "https://github.com/Byte-n/async-modal-render-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Byte-n/async-modal-render-native"
  },
  "type": "module",
  "license": "MIT",
  "author": "dancingbytes@qq.com",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/demo",
    "!dist/theme"
  ],
  "scripts": {
    "build": "father build",
    "build:watch": "father dev",
    "deploy": "gh-pages -d docs-dist",
    "dev": "docusaurus start",
    "docs:build": "docusaurus build --out-dir docs-dist",
    "docs:preview": "docusaurus serve docs-dist",
    "doctor": "father doctor",
    "lint": "eslint \"{src,tests}/**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky install",
    "prepublishOnly": "father doctor && npm run build",
    "start": "npm run dev",
    "test": "jest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/theme-live-codeblock": "^3.10.1",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.2.3",
    "@umijs/lint": "^4.0.0",
    "babel-jest": "29.7.0",
    "babel-plugin-react-native-web": "^0.21.2",
    "eslint": "^8.23.0",
    "father": "^4.1.0",
    "gh-pages": "^6.3.0",
    "husky": "^8.0.1",
    "jest": "^29.7.0",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.0.0",
    "prettier-plugin-packagejson": "^2.2.18",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-live": "^4.1.8",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "^19.2.6",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.85.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
